{
  "name": "ogamex-next",
  "version": "1.0.0",
  "description": "OGameX - Modern remake with Next.js + Supabase for AI agents",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "db:generate": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.0.0-rc.1",
    "@react-three/fiber": "^9.0.0-rc.4",
    "@react-three/postprocessing": "^3.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.0",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "gsap": "^3.14.2",
    "leva": "^0.10.1",
    "next": "^16.1.6",
    "next-intl": "^4.8.2",
    "postprocessing": "^6.38.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0",
    "three": "^0.182.0",
    "three.quarks": "^0.17.0",
    "uuid": "^13.0.0",
    "colyseus.js": "^0.15.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.2.0",
    "postcss": "^8.5.0",
    "supabase": "^2.0.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.0"
  }
}
